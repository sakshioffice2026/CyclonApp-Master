@model CyclonApp.Model.ViewModel.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Password — Cyclone Design App</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            /* background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #0f172a 100%); */
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
            padding: 20px;
        }

         .change-card { 
         background: #fff; 
        border-radius: 16px; 
         box-shadow: 0 20px 60px rgba(0,0,0,0.3); 
          width: 100%;
            max-width: 440px; 
            overflow: hidden; 
         } 

         card-top { 
         background: linear-gradient(135deg, #1a56db, #0e3fad); 
         padding: 32px 24px; 
           text-align: center; 
         }  

            .card-top .icon-wrap {
                background: rgba(255,255,255,0.15);
                border-radius: 14px;
                width: 56px;
                height: 56px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 12px;
            }

            .card-top h4 {
                color: #fff;
                font-weight: 700;
                font-size: 20px;
                margin-bottom: 4px;
            }

            .card-top p {
                color: rgba(255,255,255,0.75);
                font-size: 13px;
                margin: 0;
            }

        .card-body-inner {
            padding: 28px 28px 24px;
        }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #374151;
            margin-bottom: 6px;
        }

        .input-group-text {
            background: #f9fafb;
            border-color: #e5e7eb;
            color: #6b7280;
        }

        .form-control {
            border-color: #e5e7eb;
            font-size: 13px;
            color: #111827;
        }

            .form-control:focus {
                border-color: #1a56db;
                box-shadow: 0 0 0 3px rgba(26,86,219,0.1);
            }

        .btn-toggle { 
            background: #f9fafb; 
            border: 1px solid #e5e7eb; 
            border-left: none; 
             color: #6b7280; 
            padding: 0 12px; 
         }

            .btn-toggle:hover {
                background: #f3f4f6;
                color: #374151;
            }

        .strength-wrap {
            margin-bottom: 20px;
        }

            .strength-wrap .labels {
                display: flex;
                justify-content: space-between;
                margin-bottom: 5px;
            }

                .strength-wrap .labels span {
                    font-size: 11px;
                    color: #9ca3af;
                }

        #strengthLabel {
            font-size: 11px;
            font-weight: 600;
        }

        .progress {
            height: 4px;
            border-radius: 4px;
            background: #e9ecef;
        }

        .btn-change {
            background: linear-gradient(135deg, #1a56db, #0e3fad);
            border: none;
            color: #fff;
            width: 100%;
            padding: 11px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            transition: opacity .2s;
        }

            .btn-change:hover {
                opacity: 0.9;
                color: #fff;
            }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 18px;
            font-size: 13px;
            color: #6b7280;
            text-decoration: none;
        }

            .back-link:hover {
                color: #1a56db;
            }

        .alert {
            border-radius: 8px;
            font-size: 13px;
        }
    </style>
</head>
<body>

    <div class="change-card">

        <div class="card-top">
            <div class="icon-wrap">
                <i class="bi bi-key-fill text-white" style="font-size:24px;"></i>
            </div>
            <h4>Change Password</h4>
            <p>Enter your new password below</p>
        </div>

        <div class="card-body-inner">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success py-2 mb-3">
                    <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger py-2 mb-3">
                    <i class="bi bi-exclamation-circle me-1"></i>@TempData["Error"]
                </div>
            }

            <form asp-action="ChangePassword" asp-controller="Account" method="post">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 px-3 mb-3">
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                @* Email — hidden if logged in, visible if not *@
                @if (User.Identity!.IsAuthenticated)
                {
                    <input type="hidden" asp-for="Email" />
                    <div class="alert alert-info py-2 mb-3">
                        <i class="bi bi-person-circle me-1"></i>
                        Changing password for <strong>@Model.Email</strong>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">
                            Email Address <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="your@email.com"
                                   autocomplete="off" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"
                              style="font-size:12px;"></span>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">
                        New Password <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input asp-for="NewPassword"
                               type="password"
                               id="NewPassword"
                               class="form-control"
                               placeholder="Min 8 characters"
                               autocomplete="new-password" />
                        <button class="btn-toggle" type="button"
                                onclick="togglePassword('NewPassword', this)"
                                tabindex="-1">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"
                          style="font-size:12px;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">
                        Confirm New Password <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-lock-fill"></i>
                        </span>
                        <input asp-for="ConfirmPassword"
                               type="password"
                               id="ConfirmPassword"
                               class="form-control"
                               placeholder="Repeat new password"
                               autocomplete="new-password" />
                        <button class="btn-toggle" type="button"
                                onclick="togglePassword('ConfirmPassword', this)"
                                tabindex="-1">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"
                          style="font-size:12px;"></span>
                </div>

                @* Password strength *@
                <div class="strength-wrap">
                    <div class="labels">
                        <span>Password strength</span>
                        <span id="strengthLabel"></span>
                    </div>
                    <div class="progress">
                        <div id="strengthBar" class="progress-bar" role="progressbar"
                             style="width:0%; transition:width .3s, background .3s;"></div>
                    </div>
                </div>

                <button type="submit" class="btn-change">
                    <i class="bi bi-check-circle me-1"></i>Change Password
                </button>

            </form>

            <a asp-controller="Account" asp-action="Login" class="back-link">
                <i class="bi bi-arrow-left me-1"></i>Back to Login
            </a>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(fieldId, btn) {
            const input = document.getElementById(fieldId);
            const icon  = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }

        document.getElementById('NewPassword').addEventListener('input', function () {
            const val   = this.value;
            const bar   = document.getElementById('strengthBar');
            const label = document.getElementById('strengthLabel');
            let score   = 0;

            if (val.length >= 8)           score++;
            if (/[A-Z]/.test(val))         score++;
            if (/[0-9]/.test(val))         score++;
            if (/[^A-Za-z0-9]/.test(val))  score++;

            const levels = [
                { width: '0%',   color: '#e9ecef', text: '',       cls: '' },
                { width: '25%',  color: '#dc3545', text: 'Weak',   cls: 'text-danger' },
                { width: '50%',  color: '#fd7e14', text: 'Fair',   cls: 'text-warning' },
                { width: '75%',  color: '#ffc107', text: 'Good',   cls: 'text-warning' },
                { width: '100%', color: '#198754', text: 'Strong', cls: 'text-success' },
            ];

            const lvl            = levels[score];
            bar.style.width      = lvl.width;
            bar.style.background = lvl.color;
            label.textContent    = lvl.text;
            label.className      = lvl.cls;
        });
    </script>
</body>
</html>