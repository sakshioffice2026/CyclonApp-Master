@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}
<div class="d-flex flex-column align-items-center justify-content-center" style="min-height:60vh; text-align:center;">
    <div style="font-size:64px; color:var(--danger); margin-bottom:16px;">
        <i class="bi bi-shield-x"></i>
    </div>
    <h2 style="font-size:22px; font-weight:700; margin-bottom:8px;">Access Denied</h2>
    <p style="font-size:14px; color:var(--text-muted); max-width:400px; margin-bottom:28px;">
        You don't have permission to access this page. Please contact your administrator if you believe this is an error.
    </p>
    <a href="@Url.Action("Index","Project")" class="btn btn-primary">
        <i class="bi bi-house me-2"></i>Go to Dashboard
    </a>
</div>
