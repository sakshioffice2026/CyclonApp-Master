@{
    ViewData["Title"] = "Password Reset";
    Layout = "_Layout";
}
<div class="auth-card">
    <div class="auth-card-header">
        <div class="auth-card-logo"><i class="bi bi-check-circle"></i></div>
        <h1 class="auth-card-title">Password updated!</h1>
        <p class="auth-card-subtitle">Your password has been successfully reset</p>
    </div>
    <div class="auth-card-body text-center">
        <p style="font-size:13.5px; color:var(--text-muted); margin-bottom:24px;">
            You can now sign in with your new password.
        </p>
        <a href="@Url.Action("Login")" class="btn btn-primary w-100 py-2">
            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
        </a>
    </div>
</div>
