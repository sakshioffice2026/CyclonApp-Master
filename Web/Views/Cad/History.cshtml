@using CyclonApp.Database
@model List<ExportLog>

@{
    ViewData["Title"] = "CAD History";
    Layout = "_Layout";
    var logs = Model ?? new List<ExportLog>();
}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="bi bi-clock-history me-2 text-primary"></i>CAD History
        </h1>
        <p class="page-subtitle">All STEP / DXF / OBJ CAD generations</p>
    </div>
    <a href="@Url.Action("Index", "Project")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="card-title">
            CAD Generation Log
            <span class="badge bg-secondary ms-2">@logs.Count records</span>
        </h5>
    </div>

    @if (!logs.Any())
    {
        <div class="card-body text-center py-5">
            <h5>No CAD generations yet</h5>
            <p class="text-muted">Generate a 3D model from any revision's Export page.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Tag</th>
                        <th>Revision</th>
                        <th>User</th>
                        <th>Date</th>
                        <th>Open</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in logs)
                    {
                        <tr>
                            <td>@(log.DesignRevision?.CycloneDesign?.TagNumber ?? "-")</td>
                            <td>Rev @(log.DesignRevision?.RevisionNumber)</td>
                            <td>@(log.ExportedBy?.DisplayName ?? log.ExportedBy?.Email ?? "-")</td>
                            <td>@log.ExportedAt.ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                <a href="@Url.Action("Index", "Cad", new { revisionId = log.DesignRevisionId })"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-box me-1"></i>Re-generate / View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
