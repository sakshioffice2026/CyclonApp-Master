@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <script>
        const dimData   = @Html.Raw(Model.DimensionsJson);
        const gradeEff  = @Html.Raw(Model.GradeEfficiencyCurveJson);
        const inputDp   = @Model.ParticleSizeMicron;
        const resultEff = @Model.Efficiency;
        const resultDp  = @Model.CutDiameterMicron;
        const dpPa      = @Model.PressureDropPa;
        const dpMmWc    = @Model.PressureDropMmWc;

        function setUnit(unit) {
            document.querySelectorAll('.unit-in').forEach(el => el.style.display = unit==='in' ? '' : 'none');
            document.querySelectorAll('.unit-mm').forEach(el => el.style.display = unit==='mm' ? '' : 'none');
            document.getElementById('btnInch').classList.toggle('active', unit==='in');
            document.getElementById('btnInch').classList.toggle('btn-primary', unit==='in');
            document.getElementById('btnInch').classList.toggle('btn-outline-primary', unit!=='in');
            document.getElementById('btnMm').classList.toggle('active', unit==='mm');
            document.getElementById('btnMm').classList.toggle('btn-primary', unit==='mm');
            document.getElementById('btnMm').classList.toggle('btn-outline-primary', unit!=='mm');
        }

        (function() {
            const labels = gradeEff.map(p => p.particleSizeMicron);
            const data   = gradeEff.map(p => p.efficiencyPercent);
            const ctx    = document.getElementById('efficiencyChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels,
                    datasets: [{
                        label: 'Grade Efficiency (%)',
                        data,
                        borderColor: '#1a56db',
                        backgroundColor: 'rgba(26,86,219,.08)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 3,
                    }, {
                        label: 'Cut Diam (Dpc = ' + resultDp.toFixed(2) + ' µm)',
                        data: labels.map(() => 50),
                        borderColor: '#dc2626',
                        borderDash: [4,3],
                        borderWidth: 1.5,
                        pointRadius: 0,
                        fill: false,
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    scales: {
                        x: { type:'logarithmic', title:{display:true,text:'Particle Size (µm)',font:{size:11}}, ticks:{font:{size:10}} },
                        y: { min:0, max:100, title:{display:true,text:'Efficiency (%)',font:{size:11}}, ticks:{font:{size:10}} }
                    },
                    plugins: { legend:{ labels:{font:{size:11}} } }
                }
            });
        })();

        (function() {
            const canvas = document.getElementById('pressureGauge');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const cx = 100, cy = 110, r = 80;
            const startA = Math.PI, endA = 2 * Math.PI;
            const maxPa  = Math.max(dpPa * 1.5, 500);
            const frac   = Math.min(dpPa / maxPa, 1);
            const valA   = startA + frac * Math.PI;
            ctx.beginPath(); ctx.arc(cx,cy,r,startA,endA);
            ctx.lineWidth=16; ctx.strokeStyle='#e2e8f0'; ctx.stroke();
            const col = dpPa < 300 ? '#16a34a' : dpPa < 700 ? '#d97706' : '#dc2626';
            ctx.beginPath(); ctx.arc(cx,cy,r,startA,valA);
            ctx.lineWidth=16; ctx.strokeStyle=col; ctx.lineCap='round'; ctx.stroke();
            ctx.fillStyle='#1e293b'; ctx.font='bold 20px Inter,sans-serif'; ctx.textAlign='center';
            ctx.fillText(dpPa.toFixed(0) + ' Pa', cx, cy - 14);
            ctx.font='12px Inter,sans-serif'; ctx.fillStyle='#64748b';
            ctx.fillText(dpMmWc.toFixed(1) + ' mm WC', cx, cy + 8);
            ctx.font='11px Inter,sans-serif';
            ctx.fillText('0', cx - r - 8, cy + 16);
            ctx.fillText(maxPa.toFixed(0), cx + r + 8, cy + 16);
        })();

               (function () {
                    const container = document.getElementById('threejsContainer');
            if (!container) return;

            const width = container.clientWidth;
            const height = container.clientHeight;

            const scene = new THREE.Scene();
            scene.background = new THREE.Color(0x000000);

            //---------------------------------
            // Renderer
            //---------------------------------

            const renderer = new THREE.WebGLRenderer({
                antialias: true,
                alpha: true
            });

            renderer.setSize(width, height);
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;

            container.appendChild(renderer.domElement);

            //---------------------------------
            // Camera
            //---------------------------------

            const camera = new THREE.PerspectiveCamera(
                45,
                width / height,
                0.1,
                1000
            );

            camera.position.set(2.5, 1.5, 4);

            //---------------------------------
            // Orbit Controls
            //---------------------------------

            const controls = new THREE.OrbitControls(
                camera,
                renderer.domElement
            );

            controls.enableDamping = true;

            //---------------------------------
            // Lighting
            //---------------------------------

            scene.add(new THREE.AmbientLight(0xffffff, 1.2));

            const dir = new THREE.DirectionalLight(
                0xffffff,
                2
            );

            dir.position.set(5, 8, 5);

            dir.castShadow = true;

            scene.add(dir);

            const fill = new THREE.PointLight(
                0x60a5fa,
                1.5
            );

            fill.position.set(-5, 3, -2);

            scene.add(fill);

            //---------------------------------
            // Materials
            //---------------------------------

            const steel = new THREE.MeshPhysicalMaterial({
                color: 0xd1d5db,
                metalness: 1,
                roughness: 0.18,
                reflectivity: 1,
                clearcoat: 1,
                clearcoatRoughness: 0.1
            });

            const flangeMat = new THREE.MeshPhysicalMaterial({
                color: 0x94a3b8,
                metalness: 1,
                roughness: 0.25
            });

            const inletMat = new THREE.MeshPhysicalMaterial({
                color: 0x3b82f6,
                metalness: 0.7,
                roughness: 0.3
            });

            //---------------------------------
            // Scale Dimensions
            //---------------------------------

            const d = dimData;

            const Dc = 1;

            const barrelH =
                d.barrelHeightIn /
                d.barrelDiameterIn;

            const coneH =
                d.coneHeightIn /
                d.barrelDiameterIn;

            const exhaustD =
                d.exhaustDiaIn /
                d.barrelDiameterIn;

            const exhaustL =
                d.exhaustLengthIn /
                d.barrelDiameterIn;

            const outletD =
                d.bottomOutletIn /
                d.barrelDiameterIn;

            //---------------------------------
            // Barrel
            //---------------------------------

            const barrel = new THREE.Mesh(
                new THREE.CylinderGeometry(
                    Dc / 2,
                    Dc / 2,
                    barrelH,
                    128
                ),
                steel
            );

            barrel.castShadow = true;
            barrel.receiveShadow = true;

            scene.add(barrel);

            //---------------------------------
            // Cone
            //---------------------------------

            const cone = new THREE.Mesh(
                new THREE.CylinderGeometry(
                    outletD / 2,
                    Dc / 2,
                    coneH,
                    128
                ),
                steel
            );

            cone.position.y =
                -(barrelH / 2 + coneH / 2);

            cone.castShadow = true;

            scene.add(cone);

            //---------------------------------
            // Exhaust Tube
            //---------------------------------

            const exhaust = new THREE.Mesh(
                new THREE.CylinderGeometry(
                    exhaustD / 2,
                    exhaustD / 2,
                    exhaustL,
                    128
                ),
                steel
            );

            exhaust.position.y =
                barrelH / 2 -
                exhaustL / 2 +
                exhaustL * 0.25;

            exhaust.castShadow = true;

            scene.add(exhaust);

            //---------------------------------
            // Top Flange
            //---------------------------------

            const flange = new THREE.Mesh(
                new THREE.TorusGeometry(
                    Dc / 2,
                    0.03,
                    32,
                    128
                ),
                flangeMat
            );

            flange.rotation.x = Math.PI / 2;

            flange.position.y = barrelH / 2;

            scene.add(flange);

            //---------------------------------
            // Tangential Inlet
            //---------------------------------

            const inletW =
                d.inletWidthIn /
                d.barrelDiameterIn;

            const inletH =
                d.inletHeightIn /
                d.barrelDiameterIn;

            const inlet = new THREE.Mesh(
                new THREE.BoxGeometry(
                    inletW * 1.8,
                    inletH,
                    inletW * 0.9
                ),
                inletMat
            );

            inlet.position.set(
                Dc / 2 + inletW * 0.8,
                barrelH / 2 - inletH * 0.8,
                0
            );

            scene.add(inlet);

            //---------------------------------
            // Dust Outlet
            //---------------------------------

            const dustOutlet = new THREE.Mesh(
                new THREE.CylinderGeometry(
                    outletD / 2,
                    outletD / 2,
                    0.25,
                    64
                ),
                flangeMat
            );

            dustOutlet.position.y =
                -(barrelH / 2 + coneH + 0.12);

            scene.add(dustOutlet);

            //---------------------------------
            // Ground
            //---------------------------------

            const floor = new THREE.Mesh(
                new THREE.PlaneGeometry(20, 20),
                new THREE.ShadowMaterial({
                    opacity: 0.25
                })
            );

            floor.rotation.x = -Math.PI / 2;
            floor.position.y = -2;

            floor.receiveShadow = true;

            scene.add(floor);

            //---------------------------------
            // Swirl Particles
            //---------------------------------

            const particleCount = 500;

            const particleGeo =
                new THREE.BufferGeometry();

            const positions =
                new Float32Array(
                    particleCount * 3
                );

            particleGeo.setAttribute(
                'position',
                new THREE.BufferAttribute(
                    positions,
                    3
                )
            );

            const particles =
                new THREE.Points(
                    particleGeo,
                    new THREE.PointsMaterial({
                        color: 0xf59e0b,
                        size: 0.03
                    })
                );

            scene.add(particles);

            //---------------------------------
            // Animation
            //---------------------------------

            let t = 0;

            function animate() {

                requestAnimationFrame(
                    animate
                );

                t += 0.015;

                const p =
                    particleGeo.attributes.position
                        .array;

                for (
                    let i = 0;
                    i < particleCount;
                    i++
                ) {

                    const angle =
                        t * 5 + i * 0.2;

                    const progress =
                        (i % 100) / 100;

                    const radius =
                        0.45 -
                        progress * 0.3;

                    const y =
                        0.8 -
                        progress * 2.0;

                    p[i * 3] =
                        Math.cos(angle) *
                        radius;

                    p[i * 3 + 1] = y;

                    p[i * 3 + 2] =
                        Math.sin(angle) *
                        radius;
                }

                particleGeo.attributes.position.needsUpdate =
                    true;

                controls.update();

                renderer.render(
                    scene,
                    camera
                );
            }

            animate();

            //---------------------------------
            // Resize
            //---------------------------------

            window.addEventListener(
                'resize',
                () => {

                    const w =
                        container.clientWidth;

                    const h =
                        container.clientHeight;

                    camera.aspect = w / h;

                    camera.updateProjectionMatrix();

                    renderer.setSize(w, h);
                }
            );

        })();
    </script>
    <script>
        (function () {
            const btn = document.getElementById('btnStartFieldSolve');
            if (!btn) return;

            const revisionId   = btn.dataset.revisionId;
            const idleEl       = document.getElementById('fieldSolveIdle');
            const runningEl    = document.getElementById('fieldSolveRunning');
            const errorEl      = document.getElementById('fieldSolveError');
            const resultEl     = document.getElementById('fieldSolveResult');
            const badgeEl      = document.getElementById('fieldSolveStatusBadge');
            const fieldSelect  = document.getElementById('fieldSelect');

            const POLL_INTERVAL_MS = 4000;
            const MAX_POLL_MS      = 15 * 60 * 1000; // stop polling politely after 15 min
            let pollTimer     = null;
            let pollStartedAt = null;
            let lastResult    = null;
            let lastJobId     = null;
            let fieldChart    = null;

            // Field labels for the chart legend/tooltip — keys match the
            // pinned JSON property names on FieldResultDto exactly.
            const FIELD_LABELS = {
                pressurePa: 'Pressure (Pa)',
                vThetaMs:   'Tangential Velocity v_θ (m/s)',
                vRMs:       'Radial Velocity v_r (m/s)',
                vZMs:       'Axial Velocity v_z (m/s)',
            };

            function getAntiForgeryToken() {
                const input = document.querySelector(
                    '#fieldSolveAntiForgeryForm input[name="__RequestVerificationToken"]');
                return input ? input.value : null;
            }

            function showState(state) {
                idleEl.classList.toggle('d-none', state !== 'idle');
                runningEl.classList.toggle('d-none', state !== 'running');
                errorEl.classList.toggle('d-none', state !== 'error');
                resultEl.classList.toggle('d-none', state !== 'completed');
            }

            function setBadge(text, bg, fg) {
                if (!text) { badgeEl.classList.add('d-none'); return; }
                badgeEl.textContent = text;
                badgeEl.style.background = bg;
                badgeEl.style.color = fg;
                badgeEl.style.border = '1px solid ' + fg;
                badgeEl.classList.remove('d-none');
            }

            function stopPolling() {
                if (pollTimer) { clearTimeout(pollTimer); pollTimer = null; }
            }

            function showError(message) {
                errorEl.textContent = message;
                showState('error');
                setBadge('Failed', '#fee2e2', '#dc2626');
                btn.disabled = false;
            }

            async function parseErrorBody(resp) {
                try { return await resp.json(); } catch { return {}; }
            }

            async function startFieldSolve() {
                stopPolling();
                errorEl.classList.add('d-none');
                btn.disabled = true;
                setBadge('Starting…', '#e0e7ff', '#4338ca');

                const token = getAntiForgeryToken();
                const form = new FormData();
                if (token) form.append('__RequestVerificationToken', token);

                try {
                    const resp = await fetch(`/Design/StartFieldPrediction/${revisionId}`, {
                        method: 'POST',
                        body: form,
                    });

                    if (resp.status === 429) {
                        const body = await parseErrorBody(resp);
                        showError(body.error || 'Too many field-prediction jobs running. Try again shortly.');
                        setBadge(null);
                        return;
                    }
                    if (!resp.ok) {
                        const body = await parseErrorBody(resp);
                        showError(body.error || 'Could not start the field solve.');
                        setBadge(null);
                        return;
                    }

                    const data = await resp.json();
                    showState('running');
                    setBadge('Running', '#dbeafe', '#1d4ed8');
                    pollStartedAt = Date.now();
                    pollStatus(data.jobId);
                } catch (e) {
                    showError('Could not reach the field prediction service.');
                    setBadge(null);
                }
            }

            async function pollStatus(jobId) {
                stopPolling();
                lastJobId = jobId;

                if (Date.now() - pollStartedAt > MAX_POLL_MS) {
                    showError('This is taking longer than expected. Check back later or try again.');
                    return;
                }

                try {
                    const resp = await fetch(`/Design/FieldPredictionStatus?jobId=${encodeURIComponent(jobId)}`);

                    if (resp.status === 404) {
                        showError('Job expired before it finished. Please try again.');
                        return;
                    }
                    if (!resp.ok) {
                        const body = await parseErrorBody(resp);
                        showError(body.error || 'Lost contact with the field prediction service.');
                        return;
                    }

                    const status = await resp.json();

                    if (status.status === 'running') {
                        pollTimer = setTimeout(() => pollStatus(jobId), POLL_INTERVAL_MS);
                        return;
                    }

                    if (status.status === 'failed') {
                        showError(status.errorMessage || 'The field solve failed.');
                        return;
                    }

                    // completed
                    renderResult(status);
                    btn.disabled = false;
                    setBadge('Completed', '#dcfce7', '#16a34a');
                } catch (e) {
                    // Transient network hiccup — keep polling rather than giving up.
                    pollTimer = setTimeout(() => pollStatus(jobId), POLL_INTERVAL_MS);
                }
            }

            function renderResult(status) {
                const r = status.result;
                if (!r) { showError('Completed with no result data.'); return; }

                lastResult = r;
                document.getElementById('fsRho').textContent    = r.rhoKgm3.toFixed(4) + ' kg/m³';
                document.getElementById('fsNu').textContent      = r.nuM2s.toExponential(3) + ' m²/s';
                document.getElementById('fsVInlet').textContent  = r.vInletMs.toFixed(2) + ' m/s';
                document.getElementById('fsPoints').textContent  = r.rMeters.length.toLocaleString();

                // ROOT-CAUSE FIX: the partial's own renderEngineeringInsights()
                // function was already correct, but nothing ever called it — the
                // status response's `insights` field was just sitting unused here.
                // ROOT-CAUSE FIX (download PDF): this script runs inside an
                // IIFE, so lastJobId/revisionId aren't reachable from the
                // separate _EngineeringInsights.cshtml script block —
                // publish what its "Download PDF" button needs here.
                window.__cycloneInsightContext = {
                    jobId: lastJobId,
                    tagNumber: btn.dataset.tagNumber || '',
                    revisionNumber: btn.dataset.revisionNumber || '',
                    projectName: btn.dataset.projectName || '',
                };

                if (status.insights) {
                    renderEngineeringInsights(status.insights);
                } else {
                    const panel = document.getElementById('engineering-insights-panel');
                    if (panel) panel.style.display = 'none';
                }

                showState('completed');
                drawFieldChart(fieldSelect.value);
            }

            function colorForValue(value, min, max) {
                const t = max > min ? (value - min) / (max - min) : 0.5;
                // Simple blue (low) -> red (high) ramp — no external colormap
                // library needed for a scatter of a few thousand points.
                const r = Math.round(255 * t);
                const b = Math.round(255 * (1 - t));
                return `rgb(${r},70,${b})`;
            }

            function drawFieldChart(fieldKey) {
                if (!lastResult) return;
                const values = lastResult[fieldKey];
                if (!values) return;

                const min = Math.min(...values);
                const max = Math.max(...values);

                const points = lastResult.rMeters.map((rVal, i) => ({
                    x: rVal,
                    y: lastResult.zMeters[i],
                    v: values[i],
                }));
                const colors = points.map(p => colorForValue(p.v, min, max));

                const ctx = document.getElementById('fieldChart').getContext('2d');
                if (fieldChart) fieldChart.destroy();
                fieldChart = new Chart(ctx, {
                    type: 'scatter',
                    data: {
                        datasets: [{
                            label: FIELD_LABELS[fieldKey] || fieldKey,
                            data: points,
                            pointBackgroundColor: colors,
                            pointRadius: 3,
                            pointHoverRadius: 5,
                        }],
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: { title: { display: true, text: 'r — radius (m)', font: { size: 11 } } },
                            // z is measured from the top of the barrel downward
                            // (see field_physics.py) — reverse so "up" on the
                            // chart matches "up" in the physical cyclone.
                            y: { reverse: true, title: { display: true, text: 'z — height from top (m)', font: { size: 11 } } },
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: (c) => `r=${c.raw.x.toFixed(3)}m  z=${c.raw.y.toFixed(3)}m  ${FIELD_LABELS[fieldKey] || fieldKey}=${c.raw.v.toFixed(3)}`,
                                },
                            },
                        },
                    },
                });
            }

            fieldSelect.addEventListener('change', (e) => drawFieldChart(e.target.value));
            btn.addEventListener('click', startFieldSolve);
        })();

        // ── CFD Visualization card — separate job, separate state machine.
        // Deliberately not sharing lastJobId with the "Physics Field Solve"
        // card above: that card polls/renders raw grid data into a canvas
        // scatter chart, this one polls/renders the matplotlib PNG
        // (result.pngUrl) — same /Design/StartFieldPrediction +
        // /Design/FieldPredictionStatus endpoints, since app.py now
        // produces both the raw grid and the PNG from the same job.
        (function () {
            const btn      = document.getElementById('btnGenerateCfdImage');
            if (!btn) return;

            const revisionId = btn.dataset.revisionId;
            const idleEl        = document.getElementById('cfdImageIdle');
            const runningEl     = document.getElementById('cfdImageRunning');
            const errorEl       = document.getElementById('cfdImageError');
            const resultEl      = document.getElementById('cfdImageResult');
            const unavailableEl = document.getElementById('cfdImageUnavailable');
            const badgeEl       = document.getElementById('cfdImageStatusBadge');
            const imgEl         = document.getElementById('cfdResultImg');
            const downloadBtn   = document.getElementById('btnDownloadCfdImage');

            const POLL_INTERVAL_MS = 4000;
            const MAX_POLL_MS      = 15 * 60 * 1000;
            let pollTimer     = null;
            let pollStartedAt = null;

            function getAntiForgeryToken() {
                const input = document.querySelector(
                    '#cfdImageAntiForgeryForm input[name="__RequestVerificationToken"]');
                return input ? input.value : null;
            }

            function showState(state) {
                idleEl.classList.toggle('d-none', state !== 'idle');
                runningEl.classList.toggle('d-none', state !== 'running');
                errorEl.classList.toggle('d-none', state !== 'error');
                resultEl.classList.toggle('d-none', state !== 'completed');
                // Download only makes sense once an image is actually on screen.
                downloadBtn.classList.toggle('d-none', !(state === 'completed' && imgEl.src && !imgEl.classList.contains('d-none')));
            }

            function downloadImage() {
                if (!imgEl.src) return;
                const a = document.createElement('a');
                a.href = imgEl.src;
                a.download = `cfd-visualization-revision-${revisionId}.png`;
                document.body.appendChild(a);
                a.click();
                a.remove();
            }

            function setBadge(text, bg, fg) {
                if (!text) { badgeEl.classList.add('d-none'); return; }
                badgeEl.textContent = text;
                badgeEl.style.background = bg;
                badgeEl.style.color = fg;
                badgeEl.style.border = '1px solid ' + fg;
                badgeEl.classList.remove('d-none');
            }

            function stopPolling() {
                if (pollTimer) { clearTimeout(pollTimer); pollTimer = null; }
            }

            function showError(message) {
                errorEl.textContent = message;
                showState('error');
                setBadge('Failed', '#fee2e2', '#dc2626');
                btn.disabled = false;
            }

            async function parseErrorBody(resp) {
                try { return await resp.json(); } catch { return {}; }
            }

            async function startCfdImage() {
                stopPolling();
                errorEl.classList.add('d-none');
                btn.disabled = true;
                setBadge('Starting…', '#e0e7ff', '#4338ca');

                const token = getAntiForgeryToken();
                const form = new FormData();
                if (token) form.append('__RequestVerificationToken', token);

                try {
                    const resp = await fetch(`/Design/StartFieldPrediction/${revisionId}`, {
                        method: 'POST',
                        body: form,
                    });

                    if (resp.status === 429) {
                        const body = await parseErrorBody(resp);
                        showError(body.error || 'Too many field-prediction jobs running. Try again shortly.');
                        setBadge(null);
                        return;
                    }
                    if (!resp.ok) {
                        const body = await parseErrorBody(resp);
                        showError(body.error || 'Could not start the CFD render.');
                        setBadge(null);
                        return;
                    }

                    const data = await resp.json();
                    showState('running');
                    setBadge('Running', '#dbeafe', '#1d4ed8');
                    pollStartedAt = Date.now();
                    pollStatus(data.jobId);
                } catch (e) {
                    showError('Could not reach the field prediction service.');
                    setBadge(null);
                }
            }

            async function pollStatus(jobId) {
                stopPolling();

                if (Date.now() - pollStartedAt > MAX_POLL_MS) {
                    showError('This is taking longer than expected. Check back later or try again.');
                    return;
                }

                try {
                    const resp = await fetch(`/Design/FieldPredictionStatus?jobId=${encodeURIComponent(jobId)}&revisionId=${encodeURIComponent(revisionId)}`);

                    if (resp.status === 404) {
                        showError('Job expired before it finished. Please try again.');
                        return;
                    }
                    if (!resp.ok) {
                        const body = await parseErrorBody(resp);
                        showError(body.error || 'Lost contact with the field prediction service.');
                        return;
                    }

                    const status = await resp.json();

                    if (status.status === 'running') {
                        pollTimer = setTimeout(() => pollStatus(jobId), POLL_INTERVAL_MS);
                        return;
                    }

                    if (status.status === 'failed') {
                        showError(status.errorMessage || 'The field solve failed.');
                        return;
                    }

                    // completed
                    renderCfdImage(status.result);
                    btn.disabled = false;
                    setBadge('Completed', '#dcfce7', '#16a34a');
                } catch (e) {
                    // Transient network hiccup — keep polling rather than giving up.
                    pollTimer = setTimeout(() => pollStatus(jobId), POLL_INTERVAL_MS);
                }
            }

            function renderCfdImage(result) {
                if (!result) { showError('Completed with no result data.'); return; }

                if (result.pngUrl) {
                    unavailableEl.classList.add('d-none');
                    imgEl.classList.remove('d-none');
                    // Cache-bust: a retried job can reuse a job_id-scoped path
                    // in principle, so force a fresh fetch rather than trust
                    // the browser's cache for what looks like the same URL.
                    imgEl.src = result.pngUrl + '?t=' + Date.now();
                } else {
                    unavailableEl.textContent = result.renderError
                        ? 'The field solve completed, but the CFD image could not be rendered: ' + result.renderError
                        : 'The field solve completed, but the CFD image could not be rendered for this job.';
                    unavailableEl.classList.remove('d-none');
                    imgEl.classList.add('d-none');
                }

                showState('completed');
            }

            // ── Restore a previously-saved image on page load ────────────────
            // DesignController.FieldPredictionStatus downloads the PNG at
            // completion time and writes it into this app's own
            // wwwroot/cfd-renders/<revisionId>/, saving that durable local
            // path on the revision (CfdImageUrl/CfdImageGeneratedAt) — see
            // Results.cshtml's data-saved-png-url/data-saved-generated-at
            // attributes above. That local copy isn't subject to the Python
            // service's ~1hr render TTL, so this is a real "view whenever I
            // come back" restore. imgEl.onerror below is just a safety net
            // (e.g. the file was manually removed from disk) rather than the
            // expected case.
            function restoreSavedImage() {
                const savedUrl = btn.dataset.savedPngUrl;
                const savedAt  = btn.dataset.savedGeneratedAt;
                if (!savedUrl) return;

                unavailableEl.classList.add('d-none');
                imgEl.classList.remove('d-none');
                imgEl.onerror = () => {
                    imgEl.classList.add('d-none');
                    unavailableEl.textContent = 'The saved CFD image could not be loaded. Click "Generate CFD Image" to render a new one.';
                    unavailableEl.classList.remove('d-none');
                };
                imgEl.src = savedUrl + '?t=' + (savedAt ? new Date(savedAt).getTime() : Date.now());
                showState('completed');

                if (savedAt) {
                    setBadge('Saved ' + new Date(savedAt).toLocaleString(), '#f1f5f9', '#475569');
                }
            }

            btn.addEventListener('click', startCfdImage);
            downloadBtn.addEventListener('click', downloadImage);
            restoreSavedImage();
        })();
    </script>
}
