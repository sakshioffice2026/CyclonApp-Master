@using CyclonApp.Database
@using CyclonApp.Model.ViewModel
@model DesignResultsViewModel
@{
    ViewData["Title"] = $"Results — {Model.TagNumber} Rev {Model.RevisionNumber}";
    Layout = "_Layout";
    var eff = Model.Efficiency;
    var effColor = eff >= 95 ? "#16a34a" : eff >= 80 ? "#d97706" : "#dc2626";
    var effColor20 = eff >= 95 ? "#dcfce7" : eff >= 80 ? "#fef3c7" : "#fee2e2";
    var effColor40 = eff >= 95 ? "#86efac" : eff >= 80 ? "#fcd34d" : "#fca5a5";
    var effLabel = eff >= 95 ? "Excellent" : eff >= 80 ? "Good" : "Low";
}

<div class="page-header">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="text-mono text-muted" style="font-size:13px;">@Model.TagNumber</span>
            <span class="badge bg-secondary">Rev @Model.RevisionNumber</span>
            <span class="badge" style="background:@effColor20;color:@effColor;border:1px solid @effColor40;">
                @effLabel Efficiency
            </span>
        </div>
        <h1 class="page-title">Calculation Results</h1>
        <p class="page-subtitle">
            @Model.CycloneType &nbsp;·&nbsp; @Model.ProjectName &nbsp;·&nbsp;
            <span class="text-muted" style="font-size:12px;">
                Calculated @Model.CalculatedAt.ToString("dd MMM yyyy HH:mm")
            </span>
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="@Url.Action("Calculate", new { id = Model.DesignId })"
           class="btn btn-primary btn-sm">
            <i class="bi bi-arrow-repeat me-1"></i>New Revision
        </a>
        <a href="@Url.Action("Pdf", "Export", new { revisionId = Model.RevisionId })" class="btn btn-outline-danger btn-sm" target="_blank">
            <i class="bi bi-file-pdf me-1"></i>PDF
        </a>
        <a href="@Url.Action("Excel", "Export", new { revisionId = Model.RevisionId })" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-excel me-1"></i>Excel
        </a>
        <a href="@Url.Action("Revisions", new { id = Model.DesignId })"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-clock-history me-1"></i>History
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label">Collection Efficiency</div>
            <div class="kpi-value" style="color:@effColor">@Model.Efficiency.ToString("F2")%</div>
            <div class="kpi-sub">At @Model.ParticleSizeMicron µm</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label">Cut Diameter (Dpc)</div>
            <div class="kpi-value" style="color:var(--primary)">@Model.CutDiameterMicron.ToString("F2") µm</div>
            <div class="kpi-sub">50% separation point</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label">Pressure Drop</div>
            <div class="kpi-value" style="color:var(--warning)">@Model.PressureDropPa.ToString("F1") Pa</div>
            <div class="kpi-sub">@Model.PressureDropMmWc.ToString("F1") mm WC &nbsp;·&nbsp; @Model.PressureDropInWc.ToString("F3") in WC</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label">Barrel Diameter (Dc)</div>
            <div class="kpi-value" style="color:var(--info)">@Model.BarrelDiameterIn.ToString("F3")"</div>
            <div class="kpi-sub">@Model.BarrelDiameterMm.ToString("F1") mm</div>
        </div>
    </div>
</div>

<div class="row g-4">

    <!-- ── Left: Dimensions + Inputs ─────────────────────────────────── -->
    <div class="col-xl-4">

        <!-- Unit toggle -->
        <div class="d-flex gap-2 mb-3 align-items-center">
            <span style="font-size:12.5px; font-weight:600; color:var(--text-muted);">Units:</span>
            <div class="btn-group btn-group-sm">
                <button class="btn btn-primary active" id="btnInch" onclick="setUnit('in')">Imperial (in)</button>
                <button class="btn btn-outline-primary" id="btnMm" onclick="setUnit('mm')">Metric (mm)</button>
            </div>
        </div>

        <!-- Dimensions card -->
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="card-title"><i class="bi bi-rulers me-2 text-primary"></i>Cyclone Dimensions</h5>
            </div>
            <div class="card-body p-0">
                <table class="table mb-0" style="font-size:13px;">
                    <thead>
                        <tr>
                            <th class="ps-3">Dimension</th>
                            <th class="text-end pe-3 unit-in">Inches</th>
                            <th class="text-end pe-3 unit-mm" style="display:none;">mm</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var rows = new[]
                            {
                                                ("Barrel Dia (Dc)",    Model.BarrelDiameterIn, Model.BarrelDiameterMm),
                                                ("Inlet Height (H)",   Model.InletHeightIn,    Model.InletHeightMm),
                                                ("Inlet Width (W)",    Model.InletWidthIn,     Model.InletWidthMm),
                                                ("Barrel Height (Lb)", Model.BarrelHeightIn,   Model.BarrelHeightMm),
                                                ("Cone Height (Lc)",   Model.ConeHeightIn,     Model.ConeHeightMm),
                                                ("Exhaust Dia (De)",   Model.ExhaustDiaIn,     Model.ExhaustDiaMm),
                                                ("Exhaust Length",     Model.ExhaustLengthIn,  Model.ExhaustLengthMm),
                                                ("Bottom Outlet (Dd)", Model.BottomOutletIn,   Model.BottomOutletMm),
                                                ("Total Height",       Model.TotalHeightIn,    Model.TotalHeightMm),
                                                };
                        }
                        @foreach (var (label, inVal, mmVal) in rows)
                        {
                            <tr>
                                <td class="ps-3" style="color:var(--text-muted);">@label</td>
                                <td class="text-end pe-3 fw-600 text-mono unit-in">@inVal.ToString("F3")"</td>
                                <td class="text-end pe-3 fw-600 text-mono unit-mm" style="display:none;">@mmVal.ToString("F1")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Fluid properties -->
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="card-title"><i class="bi bi-droplet me-2 text-info"></i>Fluid Properties</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-borderless mb-0" style="font-size:13px;">
                    <tr>
                        <td class="ps-3 text-muted">Flow Rate</td>
                        <td class="pe-3 fw-600 text-mono">@Model.FlowRateCFM CFM &nbsp;·&nbsp; @Model.FlowRateM3hr.ToString("F2") m³/hr</td>
                    </tr>
                    <tr>
                        <td class="ps-3 text-muted">Inlet Velocity</td>
                        <td class="pe-3 fw-600 text-mono">@Model.InletVelocityMs.ToString("F3") m/s</td>
                    </tr>
                    <tr>
                        <td class="ps-3 text-muted">Gas Density</td>
                        <td class="pe-3 fw-600 text-mono">@Model.GasDensityKgm3.ToString("F4") kg/m³</td>
                    </tr>
                    <tr>
                        <td class="ps-3 text-muted pb-3">Gas Viscosity</td>
                        <td class="pe-3 fw-600 text-mono pb-3">@Model.GasViscosityKgms.ToString("E4") kg/m·s</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Input summary -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title"><i class="bi bi-sliders me-2 text-secondary"></i>Input Summary</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-borderless mb-0" style="font-size:12.5px;">
                    <tr><td class="ps-3 text-muted">Gas Type</td><td class="pe-3">@Model.GasType</td></tr>
                    <tr><td class="ps-3 text-muted">Temp / Pressure</td><td class="pe-3">@Model.OperatingTempC °C / @Model.OperatingPressKPa kPa</td></tr>
                    <tr><td class="ps-3 text-muted">Particle Size</td><td class="pe-3">@Model.ParticleSizeMicron µm</td></tr>
                    <tr><td class="ps-3 text-muted">Particle Density</td><td class="pe-3">@Model.ParticleDensityKgm3 kg/m³</td></tr>
                    <tr><td class="ps-3 text-muted">Eff. Turns (Nt)</td><td class="pe-3">@Model.EffectiveTurns</td></tr>
                    <tr><td class="ps-3 text-muted pb-3">No. of Cyclones</td><td class="pe-3 pb-3">@Model.NumberOfCyclones</td></tr>
                </table>
            </div>
        </div>

    </div>

    <!-- ── Center: Three.js 3D Viewer ─────────────────────────────── -->
    <div class="col-xl-4">
        <div class="card" style="height:520px; position:relative; overflow:hidden;">
            <div class="card-header">
                <h5 class="card-title"><i class="bi bi-box me-2 text-primary"></i>3D Cyclone Model</h5>
                <div class="d-flex gap-1">
                    <button class="btn btn-outline-secondary btn-sm btn-icon" id="btnResetCam" title="Reset Camera">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                    <button class="btn btn-outline-secondary btn-sm btn-icon" id="btnToggleAnim" title="Pause/Play">
                        <i class="bi bi-pause-fill" id="animIcon"></i>
                    </button>
                </div>
            </div>
            <div id="threejsContainer" style="width:100%; height:calc(100% - 53px);"></div>
            <div style="position:absolute;bottom:10px;left:50%;transform:translateX(-50%);
                        font-size:11px;color:wheat;pointer-events:none;">
                Drag to rotate &nbsp;·&nbsp; Scroll to zoom
            </div>
        </div>
    </div>

    <!-- ── Right: Grade Efficiency Chart ──────────────────────────── -->
    <div class="col-xl-4">
        <div class="card mb-3" style="height:310px;">
            <div class="card-header">
                <h5 class="card-title"><i class="bi bi-graph-up me-2 text-success"></i>Grade Efficiency Curve</h5>
            </div>
            <div class="card-body" style="height:calc(100% - 53px); padding:12px;">
                <canvas id="efficiencyChart"></canvas>
            </div>
        </div>
        <div class="card" style="height:190px;">
            <div class="card-header">
                <h5 class="card-title"><i class="bi bi-speedometer2 me-2 text-warning"></i>Pressure Drop</h5>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="pressureGauge" width="200" height="130"></canvas>
            </div>
        </div>
    </div>

</div>

<!-- ── Physics Field Solve (async job, velocity/pressure field) ────────── -->
<div class="row g-4 mt-1">
    <div class="col-12">
        <div class="card" id="fieldSolveCard">
            <form id="fieldSolveAntiForgeryForm" class="d-none">@Html.AntiForgeryToken()</form>
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="card-title mb-0">
                    <i class="bi bi-wind me-2 text-info"></i>Physics Field Solve
                </h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge d-none" id="fieldSolveStatusBadge"></span>
                    <button type="button" class="btn btn-primary btn-sm" id="btnStartFieldSolve"
                            data-revision-id="@Model.RevisionId"
                            data-tag-number="@Model.TagNumber"
                            data-revision-number="@Model.RevisionNumber"
                            data-project-name="@Model.ProjectName">
                        <i class="bi bi-cpu me-1"></i>Run Field Solve
                    </button>
                </div>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3" style="font-size:12.5px;">
                    Trains a physics-informed network for the full velocity/pressure field
                    (v<sub>r</sub>, v<sub>θ</sub>, v<sub>z</sub>, p) across this exact geometry and
                    operating point. Unlike the AI-assisted estimate above, this is a real numerical
                    solve — it typically takes a few minutes, and at most a couple can run at once
                    across all users.
                </p>

                <div id="fieldSolveIdle" style="font-size:12.5px;color:var(--text-muted);">
                    Not run for this revision yet.
                </div>

                <div id="fieldSolveRunning" class="d-none">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <span style="font-size:12.5px;">Training in progress — this updates automatically, no need to refresh.</span>
                    </div>
                </div>

                <div id="fieldSolveError" class="d-none p-2 mb-2"
                     style="background:#fee2e2;border:1px solid #fca5a5;border-radius:6px;font-size:12.5px;color:#dc2626;"></div>

                <div id="fieldSolveResult" class="d-none">
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md-3">
                            <div class="kpi-card">
                                <div class="kpi-label">Gas Density</div>
                                <div class="kpi-value" style="font-size:18px;" id="fsRho">—</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-card">
                                <div class="kpi-label">Kinematic Viscosity</div>
                                <div class="kpi-value" style="font-size:18px;" id="fsNu">—</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-card">
                                <div class="kpi-label">Inlet Velocity</div>
                                <div class="kpi-value" style="font-size:18px;" id="fsVInlet">—</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-card">
                                <div class="kpi-label">Grid Points</div>
                                <div class="kpi-value" style="font-size:18px;" id="fsPoints">—</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span style="font-size:12.5px;font-weight:600;color:var(--text-muted);">Field:</span>
                        <select class="form-select form-select-sm" id="fieldSelect" style="width:auto;">
                            <option value="pressurePa">Pressure (Pa)</option>
                            <option value="vThetaMs">Tangential Velocity v_θ (m/s)</option>
                            <option value="vRMs">Radial Velocity v_r (m/s)</option>
                            <option value="vZMs">Axial Velocity v_z (m/s)</option>
                        </select>
                    </div>
                    <div style="height:420px;">
                        <canvas id="fieldChart"></canvas>
                    </div>
                    <p class="text-muted mt-2 mb-0" style="font-size:11px;">
                        Axisymmetric cross-section: horizontal = radius from centerline r (m), vertical = height
                        from top of barrel z (m). Each point is a solved grid location, colored by the selected field.
                    </p>

                    @* ROOT-CAUSE FIX: this partial existed in the repo but was never
                       included anywhere, so #engineering-insights-panel and
                       renderEngineeringInsights() never existed on the rendered page
                       at all — see renderResult() below for the matching JS-side fix
                       (calling renderEngineeringInsights with status.insights). *@
                    <partial name="_EngineeringInsights" />
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── CFD Visualization (rendered PNG, separate from the raw field-solve card) ── -->
<div class="row g-4 mt-1">
    <div class="col-12">
        <div class="card" id="cfdImageCard">
            <form id="cfdImageAntiForgeryForm" class="d-none">@Html.AntiForgeryToken()</form>
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="card-title mb-0">
                    <i class="bi bi-image me-2 text-primary"></i>CFD Visualization
                </h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge d-none" id="cfdImageStatusBadge"></span>
                    <button type="button" class="btn btn-primary btn-sm" id="btnGenerateCfdImage"
                            data-revision-id="@Model.RevisionId"
                            data-saved-png-url="@Model.CfdImageUrl"
                            data-saved-generated-at="@(Model.CfdImageGeneratedAt?.ToString("o"))">
                        <i class="bi bi-image me-1"></i>Generate CFD Image
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="btnDownloadCfdImage">
                        <i class="bi bi-download me-1"></i>Download
                    </button>
                </div>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3" style="font-size:12.5px;">
                    Renders a CFD-style contour image of this design — velocity streamlines and
                    static pressure, side by side — from the same physics field solve as above.
                    This runs its own field-solve job, so it takes a few minutes and counts
                    against the same concurrent-job limit as "Run Field Solve".
                </p>

                <div id="cfdImageIdle" style="font-size:12.5px;color:var(--text-muted);">
                    Not generated for this revision yet.
                </div>

                <div id="cfdImageRunning" class="d-none">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <span style="font-size:12.5px;">Solving and rendering — this updates automatically, no need to refresh.</span>
                    </div>
                </div>

                <div id="cfdImageError" class="d-none p-2 mb-2"
                     style="background:#fee2e2;border:1px solid #fca5a5;border-radius:6px;font-size:12.5px;color:#dc2626;"></div>

                <div id="cfdImageResult" class="d-none">
                    <div id="cfdImageUnavailable" class="d-none p-2 mb-2"
                         style="background:#fef9c3;border:1px solid #fde68a;border-radius:6px;font-size:12.5px;color:#92400e;">
                        The field solve completed, but the CFD image could not be rendered for this job.
                    </div>
                    <div class="text-center">
                        <img id="cfdResultImg" src="" alt="CFD result: velocity streamlines and static pressure"
                             style="max-width:100%;border:1px solid var(--border);border-radius:6px;" />
                    </div>
                    <p class="text-muted mt-2 mb-0" style="font-size:11px;">
                        Left: geometry + velocity streamlines. Right: static pressure slice.
                        Both panels share the design's own solved geometry and field values.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

