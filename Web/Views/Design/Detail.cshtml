@model CyclonApp.Model.ViewModel.RevisionListViewModel;
@{
    ViewData["Title"] = Model.TagNumber ?? "Design Detail";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="text-mono text-muted" style="font-size:13px;">@(Model.TagNumber ?? "—")</span>
            <span class="badge bg-primary" style="font-size:11px;">@Model.CycloneType</span>
        </div>
        <h1 class="page-title">@(Model.DesignName ?? Model.TagNumber ?? "Cyclone Design")</h1>
        <p class="page-subtitle">Project: <strong>@Model.ProjectName</strong></p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="@Url.Action("Calculate", new { id = Model.DesignId })" class="btn btn-primary">
            <i class="bi bi-calculator me-1"></i>New Revision
        </a>
        @if (Model.Revisions.Count >= 2)
        {
            <a href="@Url.Action("Compare", new { designId = Model.DesignId })" class="btn btn-outline-info">
                <i class="bi bi-columns-gap me-1"></i>Compare
            </a>
        }
        <a href="@Url.Action("Detail","Project", new { id = Model.ProjectId })" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

@if (!Model.Revisions.Any())
{
    <div class="card">
        <div class="card-body empty-state">
            <i class="bi bi-calculator"></i>
            <h5>No calculations yet</h5>
            <p class="text-muted" style="font-size:13px;">Enter design parameters to run the first calculation.</p>
            <a href="@Url.Action("Calculate", new { id = Model.DesignId })" class="btn btn-primary btn-sm mt-1">
                <i class="bi bi-calculator me-1"></i>Calculate Now
            </a>
        </div>
    </div>
}
else
{
    var latest = Model.Revisions.First();
    if (latest.HasResults)
    {
        var ec = latest.Efficiency >= 95 ? "#16a34a" : latest.Efficiency >= 80 ? "#d97706" : "#dc2626";
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="kpi-card">
                    <div class="kpi-label">Latest Efficiency</div>
                    <div class="kpi-value" style="color:@ec">@latest.Efficiency?.ToString("F2")%</div>
                    <div class="kpi-sub">Rev @latest.RevisionNumber</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="kpi-card">
                    <div class="kpi-label">Cut Diameter</div>
                    <div class="kpi-value" style="color:var(--primary)">@latest.CutDiameter?.ToString("F2") µm</div>
                    <div class="kpi-sub">50% separation</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="kpi-card">
                    <div class="kpi-label">Pressure Drop</div>
                    <div class="kpi-value" style="color:var(--warning)">@latest.PressureDropPa?.ToString("F1") Pa</div>
                    <div class="kpi-sub">Latest revision</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="kpi-card">
                    <div class="kpi-label">Total Revisions</div>
                    <div class="kpi-value" style="color:var(--text)">@Model.Revisions.Count</div>
                    <div class="kpi-sub"><a href="@Url.Action("Compare", new { designId = Model.DesignId })" style="font-size:11.5px;">Compare revisions →</a></div>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h5 class="card-title">
                <i class="bi bi-clock-history me-2 text-primary"></i>Revision History
                <span class="badge bg-secondary ms-1">@Model.Revisions.Count</span>
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Rev.</th>
                        <th>Note</th>
                        <th>Flow (CFM)</th>
                        <th>Particle (µm)</th>
                        <th>Efficiency</th>
                        <th>Cut Dia</th>
                        <th>ΔP (Pa)</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rev in Model.Revisions)
                    {
                        <tr class="@(rev.IsLatest ? "tr-latest" : "")">
                            <td>
                                <span class="badge @(rev.IsLatest ? "bg-primary" : "bg-secondary")">Rev @rev.RevisionNumber</span>
                                @if (rev.IsLatest)
                                {
                                    <div style="font-size:10px;color:var(--primary);">Latest</div>
                                }
                            </td>
                            <td style="font-size:12.5px;color:var(--text-muted);max-width:140px;">
                                <span class="text-truncate d-block">@(rev.RevisionNote ?? "—")</span>
                            </td>
                            <td class="text-mono">@rev.FlowRateCFM</td>
                            <td class="text-mono">@rev.ParticleSizeMicron</td>
                            <td>
                                @if (rev.HasResults && rev.Efficiency.HasValue)
                                {
                                    var efcc = rev.Efficiency >= 95 ? "text-success" : rev.Efficiency >= 80 ? "text-warning" : "text-danger";
                                    <span class="fw-600 @efcc">@rev.Efficiency.Value.ToString("F2")%</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-mono">@(rev.CutDiameter.HasValue ? rev.CutDiameter.Value.ToString("F2") + " µm" : "—")</td>
                            <td class="text-mono">@(rev.PressureDropPa.HasValue ? rev.PressureDropPa.Value.ToString("F1") : "—")</td>
                            <td style="font-size:12px;color:var(--text-muted);">@rev.CreatedAt.ToString("dd MMM yy")</td>
                            <td>
                                <div class="d-flex gap-1">
                                    @if (rev.HasResults)
                                    {
                                        <a href="@Url.Action("Results","Design", new { id = rev.Id })"
                                           class="btn btn-icon btn-outline-primary btn-sm" title="View Results">
                                            <i class="bi bi-bar-chart"></i>
                                        </a>
                                    }
                                    <a href="@Url.Action("Calculate","Design", new { id = Model.DesignId, fromRevision = rev.Id })"
                                       class="btn btn-icon btn-outline-secondary btn-sm" title="New revision from this">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </a>
                                    <div class="dropdown">
                                        <button class="btn btn-icon btn-outline-secondary btn-sm dropdown-toggle no-caret"
                                                data-bs-toggle="dropdown" title="More actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end" style="font-size:13px;min-width:200px">
                                            @if (rev.HasResults)
                                            {
                                                <li>
                                                    <a class="dropdown-item"
                                                       href="@Url.Action("Results","Design", new { id = rev.Id })">
                                                        <i class="bi bi-bar-chart me-2"></i>View Results
                                                    </a>
                                                </li>
                                            }
                                            <li>
                                                <a class="dropdown-item"
                                                   href="@Url.Action("Calculate","Design", new { id = Model.DesignId, fromRevision = rev.Id })">
                                                    <i class="bi bi-arrow-repeat me-2"></i>New Revision from This
                                                </a>
                                            </li>
                                            @if (Model.Revisions.Count >= 2)
                                            {
                                                <li>
                                                    <a class="dropdown-item"
                                                       href="@Url.Action("Compare","Design", new { designId = Model.DesignId, revAId = rev.Id })">
                                                        <i class="bi bi-arrows-expand me-2"></i>Compare Revisions
                                                    </a>
                                                </li>
                                            }
                                            @if (rev.HasResults)
                                            {
                                                <li><hr class="dropdown-divider" /></li>
                                                <li>
                                                    <a class="dropdown-item"
                                                       href="@Url.Action("Pdf","Export", new { revisionId = rev.Id })"
                                                       target="_blank">
                                                        <i class="bi bi-file-pdf me-2 text-danger"></i>Export PDF
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item"
                                                       href="@Url.Action("Excel","Export", new { revisionId = rev.Id })">
                                                        <i class="bi bi-file-excel me-2 text-success"></i>Export Excel
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Styles {
    <style>
        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 18px 20px;
            box-shadow: var(--shadow);
        }

        .kpi-label {
            font-size: 11.5px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .kpi-value {
            font-size: 26px;
            font-weight: 700;
            line-height: 1.1;
        }

        .kpi-sub {
            font-size: 11.5px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .fw-600 {
            font-weight: 600;
        }

        .tr-latest {
            background: rgba(26,86,219,.04);
        }

        .no-caret::after {
            display: none !important;
        }
    </style>
}
