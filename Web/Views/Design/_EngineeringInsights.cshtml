@* Renders into a container the results page already has for the field-prediction
   job (e.g. inside the same panel that polls FieldPredictionStatus). Expects
   window.renderEngineeringInsights(insights) to be called with the "Insights"
   object from the FieldPredictionStatus JSON response once status is "completed". *@

<div id="engineering-insights-panel" style="display:none; margin-top:24px; font-family:inherit;">
    <div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
        <h3 style="margin:0;">AI Engineering Insights</h3>
        <button type="button" id="btnDownloadInsightPdf" class="btn btn-outline-danger btn-sm">
            Download PDF
        </button>
    </div>

    <div id="ei-health-score" style="font-size:2em; font-weight:bold;"></div>
    <div id="ei-grade" style="margin-bottom:16px;"></div>

    <div id="ei-physics-validation" style="margin-bottom:16px;">
        <h4>Physics Validation</h4>
        <div id="ei-physics-items"></div>
        <div id="ei-confidence"></div>
    </div>

    <div id="ei-cards"></div>

    <div id="ei-risk-indicators" style="margin-top:16px;">
        <h4>Risk Indicators</h4>
        <div id="ei-risk-bars"></div>
    </div>

    <div id="ei-summary" style="margin-top:16px; font-style:italic;"></div>

    <div id="ei-conclusion" style="margin-top:20px; padding:14px 16px; border-radius:8px;">
        <h4 style="margin-top:0;">Conclusion</h4>
        <p id="ei-conclusion-verdict" style="margin:0;"></p>
        <div id="ei-conclusion-actions-wrap" style="display:none; margin-top:10px;">
            <div style="font-weight:bold; font-size:0.9em;">Priority actions, in order:</div>
            <ol id="ei-conclusion-actions" style="margin:6px 0 0; padding-left:20px;"></ol>
        </div>
    </div>
</div>

<script>
    function eiSeverityColor(severity) {
        if (severity === "Critical") return "#d9534f";
        if (severity === "Warning") return "#f0ad4e";
        return "#5cb85c";
    }

    function eiSeverityIcon(severity) {
        if (severity === "Critical") return "\u2716"; // ✖
        if (severity === "Warning") return "\u26A0";   // ⚠
        return "\u2713"; // ✓
    }

    function eiLevelColor(level) {
        if (level === "High") return "#d9534f";
        if (level === "Medium") return "#f0ad4e";
        return "#5cb85c";
    }

    function renderEngineeringInsights(insights) {
        if (!insights) return;

        var panel = document.getElementById("engineering-insights-panel");
        panel.style.display = "block";

        document.getElementById("ei-health-score").textContent =
            insights.healthScore + " / 100";
        document.getElementById("ei-health-score").style.color =
            insights.healthScore >= 90 ? "#5cb85c" :
            insights.healthScore >= 75 ? "#5bc0de" :
            insights.healthScore >= 60 ? "#f0ad4e" : "#d9534f";

        document.getElementById("ei-grade").textContent = insights.grade;

        var pv = insights.physicsValidation;
        var pvHtml = "";
        pvHtml += "<div>" + (pv.massConservationPassed ? "\u2713" : "\u2716") + " Mass Conservation</div>";
        pvHtml += "<div>" + (pv.boundaryConditionsPassed ? "\u2713" : "\u2716") + " Boundary Conditions</div>";
        pvHtml += "<div>" + (pv.convergencePassed ? "\u2713" : "\u2716") + " Model Convergence</div>";
        document.getElementById("ei-physics-items").innerHTML = pvHtml;
        document.getElementById("ei-confidence").textContent =
            "Simulation Confidence: " + pv.confidencePercent + "%";

        var cardsHtml = "";
        (insights.insights || []).forEach(function (item) {
            var color = eiSeverityColor(item.severity);
            var icon = eiSeverityIcon(item.severity);
            cardsHtml += '<div style="border-left:4px solid ' + color + '; padding:10px 14px; margin-bottom:10px; background:#fafafa;">';
            cardsHtml += '<div style="font-weight:bold; color:' + color + ';">' + icon + ' ' + item.category + '</div>';
            cardsHtml += '<div><strong>What happened?</strong> ' + item.whatHappened + '</div>';
            cardsHtml += '<div><strong>Why?</strong> ' + item.why + '</div>';
            if (item.impact && item.impact.length) {
                cardsHtml += '<div><strong>Impact:</strong><ul>';
                item.impact.forEach(function (i) { cardsHtml += '<li>' + i + '</li>'; });
                cardsHtml += '</ul></div>';
            }
            cardsHtml += '<div><strong>Recommendation:</strong> ' + item.recommendation + '</div>';
            cardsHtml += '</div>';
        });
        document.getElementById("ei-cards").innerHTML = cardsHtml;

        var riskHtml = "";
        (insights.riskIndicators || []).forEach(function (r) {
            var color = eiLevelColor(r.level);
            riskHtml += '<div style="margin-bottom:8px;">';
            riskHtml += '<div>' + r.name + ' — ' + r.percent + '% (' + r.level + ')</div>';
            riskHtml += '<div style="background:#eee; height:10px; width:100%; max-width:300px;">';
            riskHtml += '<div style="background:' + color + '; height:10px; width:' + r.percent + '%;"></div>';
            riskHtml += '</div></div>';
        });
        document.getElementById("ei-risk-bars").innerHTML = riskHtml;

        document.getElementById("ei-summary").textContent = insights.summary || "";

        var conclusion = insights.conclusion || {};
        var readyToProceed = !!conclusion.readyToProceed;
        var conclusionBox = document.getElementById("ei-conclusion");
        conclusionBox.style.background = readyToProceed ? "#f0fdf4" : "#fef2f2";
        conclusionBox.style.border = "1px solid " + (readyToProceed ? "#bbf7d0" : "#fecaca");

        document.getElementById("ei-conclusion-verdict").textContent = conclusion.verdict || "";

        var actions = conclusion.priorityActions || [];
        var actionsWrap = document.getElementById("ei-conclusion-actions-wrap");
        var actionsList = document.getElementById("ei-conclusion-actions");
        actionsList.innerHTML = "";
        if (actions.length) {
            actions.forEach(function (a) {
                var li = document.createElement("li");
                li.textContent = a;
                li.style.marginBottom = "3px";
                actionsList.appendChild(li);
            });
            actionsWrap.style.display = "block";
        } else {
            actionsWrap.style.display = "none";
        }
    }

    (function () {
        const downloadBtn = document.getElementById("btnDownloadInsightPdf");
        if (!downloadBtn) return;

        downloadBtn.addEventListener("click", function () {
            const ctx = window.__cycloneInsightContext;
            if (!ctx || !ctx.jobId) {
                alert("Run the field solve first, then you can download the insight report.");
                return;
            }

            const params = new URLSearchParams({
                jobId: ctx.jobId,
                tagNumber: ctx.tagNumber || "",
                revisionNumber: ctx.revisionNumber || "",
                projectName: ctx.projectName || "",
            });
            window.open("/Design/EngineeringInsightPdf?" + params.toString(), "_blank");
        });
    })();
</script>
