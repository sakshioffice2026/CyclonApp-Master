@using CyclonApp.Database
@model CyclonApp.Model.ViewModel.DesignExportViewModel

@{
    ViewData["Title"] = "Export History";
    Layout = "_Layout";

    var logs = Model?.ExportLogs ?? new List<ExportLog>();
}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="bi bi-clock-history me-2 text-primary"></i>
            Export History
        </h1>
        <p class="page-subtitle">
            All PDF and Excel exports
        </p>
    </div>

    <a href="@Url.Action("Index")"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Back
    </a>
</div>

<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <h3>@logs.Count</h3>
                <small>Total Exports</small>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <h3>@logs.Count(x => x.ExportType == ExportType.PDF)</h3>
                <small>PDF Exports</small>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <h3>@logs.Count(x => x.ExportType == ExportType.Excel)</h3>
                <small>Excel Exports</small>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <h3>@logs.Select(x => x.ExportedByUserId).Distinct().Count()</h3>
                <small>Users</small>
            </div>
        </div>
    </div>

</div>

<div class="card">

    <div class="card-header">
        <h5 class="card-title">
            Export Log
            <span class="badge bg-secondary ms-2">
                @logs.Count records
            </span>
        </h5>
    </div>

    @if (!logs.Any())
    {
        <div class="card-body text-center py-5">
            <h5>No exports found</h5>
            <p class="text-muted">
                Export history will appear here.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped">

                <thead>
                    <tr>
                        <th>Tag</th>
                        <th>Revision</th>
                        <th>Format</th>
                        <th>User</th>
                        <th>Date</th>
                        <th>Download</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var log in logs)
                    {
                        <tr>

                            <td>
                                @(log.DesignRevision?.CycloneDesign?.TagNumber ?? "-")
                            </td>

                            <td>
                                Rev @(log.DesignRevision?.RevisionNumber)
                            </td>

                            <td>
                                @if (log.ExportType == ExportType.PDF)
                                {
                                    <span class="badge bg-danger">
                                        PDF
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Excel
                                    </span>
                                }
                            </td>

                            <td>
                                @(
                                    log.ExportedBy?.DisplayName
                                    ?? log.ExportedBy?.Email
                                    ?? "-"
                                    )
                            </td>

                            <td>
                                @log.ExportedAt.ToString("dd MMM yyyy HH:mm")
                            </td>

                            <td>

                                <div class="d-flex gap-1">

                                    <a href="/Export/Pdf/@log.DesignRevisionId"
                                       class="btn btn-sm btn-outline-danger"
                                       target="_blank">
                                        PDF
                                    </a>

                                    <a href="/Export/Excel/@log.DesignRevisionId"
                                       class="btn btn-sm btn-outline-success">
                                        Excel
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>