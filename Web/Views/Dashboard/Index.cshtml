@using CyclonApp.Model.DTOs
@using CyclonApp.Repositories.Contracts
@using System.Text.Json
@model DashboardDto
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";

    var role = ViewBag.Role as string ?? "";
    var userName = ViewBag.UserName as string ?? "";

    var isSuperAdmin = role == "SuperAdmin";
    var isClientAdmin = role == "ClientAdmin";
    var isEngineer = role == "Engineer";
    var isViewer = role == "Viewer";

    var jsonOptions = new JsonSerializerOptions
            {
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase
            };

    string Json(object o) => JsonSerializer.Serialize(o, jsonOptions);
}
<div class="alert alert-info mb-3">
    Status Count: @Model.ProjectsByStatus.Count |
    Primary Count:
    @(isSuperAdmin ? Model.ProjectsPerTenant.Count : Model.DesignsByCycloneType.Count) |
    Activity Count:
    @(isEngineer ? Model.MyRevisionsPerMonth.Count : Model.RevisionsPerMonth.Count)
</div>
@* ── KPI CARDS ──────────────────────────────────────────────────────────── *@
<div class="page-header">
    <div>
        <h1 class="page-title"><i class="bi bi-grid me-2 text-primary"></i>Dashboard</h1>
        <p class="page-subtitle">Welcome back, <strong>@userName</strong> &nbsp;·&nbsp; <span class="badge bg-primary-subtle text-primary">@role</span></p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:#EFF6FF"><i class="bi bi-folder2 text-primary fs-4"></i></div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalProjects</div>
                <div class="kpi-label">Projects</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:#F0FDF4"><i class="bi bi-diagram-3 text-success fs-4"></i></div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalDesigns</div>
                <div class="kpi-label">Designs</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:#FFF7ED"><i class="bi bi-calculator text-warning fs-4"></i></div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalRevisions</div>
                <div class="kpi-label">@(isEngineer ? "My Calculations" : "Calculations")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        @if (isSuperAdmin)
        {
            <div class="kpi-card">
                <div class="kpi-icon" style="background:#F5F3FF"><i class="bi bi-building text-purple fs-4"></i></div>
                <div class="kpi-body">
                    <div class="kpi-value">@Model.TotalTenants</div>
                    <div class="kpi-label">Tenants</div>
                </div>
            </div>
        }
        else
        {
            <div class="kpi-card">
                <div class="kpi-icon" style="background:#FFF1F2"><i class="bi bi-file-earmark-arrow-down text-danger fs-4"></i></div>
                <div class="kpi-body">
                    <div class="kpi-value">@Model.TotalExports</div>
                    <div class="kpi-label">Exports</div>
                </div>
            </div>
        }
    </div>
</div>

@* ── ROW 1: Projects by Status + Primary Chart ────────────────────────── *@
<div class="row g-4 mb-4">
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header">
                <h6 class="card-title mb-0"><i class="bi bi-pie-chart me-2 text-primary"></i>Projects by Status</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div style="height:320px">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header">
                <h6 class="card-title mb-0">
                    <i class="bi bi-bar-chart me-2 text-primary"></i>
                    @if (isSuperAdmin)
                    {
                        <text>Projects per Tenant</text>
                    }
                    else
                    {
                        <text>Designs by Cyclone Type</text>
                    }
                </h6>
            </div>
            <div class="card-body">
                <canvas id="primaryBarChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

@* ── ROW 2: Activity Line + Efficiency Distribution ───────────────────── *@
<div class="row g-4 mb-4">
    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header">
                <h6 class="card-title mb-0">
                    <i class="bi bi-graph-up me-2 text-primary"></i>
                    @if (isEngineer)
                    {
                        <text>My Calculations — Last 6 Months</text>
                    }
                    else
                    {
                        <text>Calculations — Last 6 Months</text>
                    }
                </h6>
            </div>
            <div class="card-body">
                <canvas id="activityChart" height="200"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header">
                <h6 class="card-title mb-0"><i class="bi bi-bar-chart-steps me-2 text-primary"></i>Efficiency Distribution</h6>
            </div>
            <div class="card-body">
                <canvas id="efficiencyChart" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

@* ── ROW 3: SuperAdmin extra + Exports / Users ────────────────────────── *@
@if (isSuperAdmin || isClientAdmin)
{
    <div class="row g-4 mb-4">
        @if (isSuperAdmin)
        {
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header">
                        <h6 class="card-title mb-0"><i class="bi bi-people me-2 text-primary"></i>Users per Tenant</h6>
                    </div>
                    <div class="card-body">
                        <canvas id="usersChart" height="200"></canvas>
                    </div>
                </div>
            </div>
        }
        <div class="col-md-@(isSuperAdmin ? "6" : "12")">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="card-title mb-0"><i class="bi bi-download me-2 text-primary"></i>Exports — Last 6 Months</h6>
                </div>
                <div class="card-body">
                    <canvas id="exportsChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>
}

@* ── ROW 4: Recent items ──────────────────────────────────────────────── *@
<div class="row g-4">
    @if (Model.RecentProjects.Any())
    {
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h6 class="card-title mb-0"><i class="bi bi-folder2-open me-2 text-primary"></i>Recent Projects</h6>
                    <a href="@Url.Action("Index","Project")" class="btn btn-sm btn-outline-secondary">View All</a>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.RecentProjects)
                    {
                        <a href="@(item.Url ?? "#")" class="list-group-item list-group-item-action py-2 px-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-600 text-sm">@item.Title</div>
                                    @if (item.SubTitle != null)
                                    {
                                        <div class="text-muted" style="font-size:12px">@item.SubTitle</div>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge rounded-pill" style="background:@item.BadgeColor;font-size:10.5px">@item.Badge</span>
                                    <span class="text-muted" style="font-size:11px">@item.Date.ToString("dd MMM")</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    @if (Model.RecentCalculations.Any())
    {
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h6 class="card-title mb-0"><i class="bi bi-calculator me-2 text-primary"></i>Recent Calculations</h6>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.RecentCalculations)
                    {
                        <a href="@(item.Url ?? "#")" class="list-group-item list-group-item-action py-2 px-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-600 text-sm">@item.Title</div>
                                    @if (item.SubTitle != null)
                                    {
                                        <div class="text-muted" style="font-size:12px">@item.SubTitle</div>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge rounded-pill" style="background:@item.BadgeColor;font-size:10.5px">@item.Badge</span>
                                    <span class="text-muted" style="font-size:11px">@item.Date.ToString("dd MMM")</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    @if (Model.RecentExports.Any())
    {
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h6 class="card-title mb-0"><i class="bi bi-download me-2 text-primary"></i>Recent Exports</h6>
                    <a href="@Url.Action("Index","Export")" class="btn btn-sm btn-outline-secondary">View All</a>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.RecentExports)
                    {
                        <div class="list-group-item py-2 px-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="fw-600 text-sm">@item.Title</div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge rounded-pill" style="background:@item.BadgeColor;font-size:10.5px">@item.Badge</span>
                                    <span class="text-muted" style="font-size:11px">@item.Date.ToString("dd MMM")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            console.log("ChartJS Loaded:", typeof Chart);

            const statusData   = @Html.Raw(Json(Model.ProjectsByStatus));
            const primaryData  = @Html.Raw(Json(isSuperAdmin ? Model.ProjectsPerTenant : Model.DesignsByCycloneType));
            const activityData = @Html.Raw(Json(isEngineer ? Model.MyRevisionsPerMonth : Model.RevisionsPerMonth));
            const effData      = @Html.Raw(Json(Model.EfficiencyDistribution));
            const exportsData  = @Html.Raw(Json(Model.ExportsPerMonth));
            const usersData    = @Html.Raw(Json(Model.UsersPerTenant));

            console.log("statusData", statusData);
            console.log("primaryData", primaryData);
            console.log("activityData", activityData);
            console.log("effData", effData);

            Chart.defaults.font.family = "'Segoe UI', Arial";
            Chart.defaults.color = "#64748B";

            // STATUS CHART

            const statusCanvas = document.getElementById('statusChart');

            if (statusCanvas && statusData.length > 0) {

                new Chart(statusCanvas, {
                    type: 'doughnut',
                    data: {
                        labels: statusData.map(x => x.label),
                        datasets: [{
                            data: statusData.map(x => x.value),
                            backgroundColor: statusData.map(x => x.color)
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }

            // PRIMARY CHART

            const primaryCanvas = document.getElementById('primaryBarChart');

            if (primaryCanvas && primaryData.length > 0) {

                new Chart(primaryCanvas, {
                    type: 'bar',
                    data: {
                        labels: primaryData.map(x => x.label),
                        datasets: [{
                            data: primaryData.map(x => x.value),
                            backgroundColor: primaryData.map(x =>
                                x.color || '#1A56DB')
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }

            // ACTIVITY

            const activityCanvas = document.getElementById('activityChart');

            if (activityCanvas && activityData.length > 0) {

                new Chart(activityCanvas, {
                    type: 'line',
                    data: {
                        labels: activityData.map(x => x.label),
                        datasets: [{
                            label: 'Activity',
                            data: activityData.map(x => x.value),
                            borderColor: '#1A56DB',
                            backgroundColor: 'rgba(26,86,219,.15)',
                            fill: true,
                            tension: .35
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }

            // EFFICIENCY

            const efficiencyCanvas = document.getElementById('efficiencyChart');

            if (efficiencyCanvas && effData.length > 0) {

                new Chart(efficiencyCanvas, {
                    type: 'bar',
                    data: {
                        labels: effData.map(x => x.label),
                        datasets: [{
                            data: effData.map(x => x.value),
                            backgroundColor: effData.map(x => x.color)
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }

            // EXPORTS

            const exportsCanvas = document.getElementById('exportsChart');

            if (exportsCanvas && exportsData.length > 0) {

                new Chart(exportsCanvas, {
                    type: 'bar',
                    data: {
                        labels: exportsData.map(x => x.label),
                        datasets: [{
                            data: exportsData.map(x => x.value),
                            backgroundColor: '#DC2626'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }

            // USERS

            const usersCanvas = document.getElementById('usersChart');

            if (usersCanvas && usersData.length > 0) {

                new Chart(usersCanvas, {
                    type: 'bar',
                    data: {
                        labels: usersData.map(x => x.label),
                        datasets: [{
                            data: usersData.map(x => x.value),
                            backgroundColor: '#7C3AED'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }

        });
    </script>

}
@section Styles {
    <style>
        .kpi-card {
            display: flex;
            align-items: center;
            gap: 14px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 16px 18px;
            box-shadow: var(--shadow);
            transition: box-shadow .18s;
        }

            .kpi-card:hover {
                box-shadow: var(--shadow-md);
            }

        .kpi-icon {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .kpi-value {
            font-size: 26px;
            font-weight: 700;
            color: var(--text);
            line-height: 1;
        }

        .kpi-label {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 3px;
        }

        .fw-600 {
            font-weight: 600;
        }

        .text-sm {
            font-size: 13.5px;
        }

        .text-purple {
            color: #7C3AED;
        }

        .bg-primary-subtle {
            background: #EFF6FF !important;
        }

        .list-group-item-action:hover {
            background: var(--surface-2, #F8FAFC);
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
	<script>
			// Chart.js global config can go here if needed
                console.log("Chart:", Chart);

    console.log("statusData", statusData);
    console.log("primaryData", primaryData);
    console.log("activityData", activityData);
    console.log("effData", effData);
    console.log("exportsData", exportsData);
    console.log("usersData", usersData);
	</script>
}
